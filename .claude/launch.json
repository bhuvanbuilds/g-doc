{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "frontend-noauth",
      "runtimeExecutable": "env",
      "runtimeArgs": ["NEXT_PUBLIC_SUPABASE_URL=", "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=", "npm", "--prefix", "frontend", "run", "dev"],
      "port": 3005,
      "autoPort": true
    }
  ]
}
